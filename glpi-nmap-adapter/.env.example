# Copia questo file in .env e inserisci i tuoi valori:
#   cp .env.example .env && chmod 600 .env

GLPI_BASE_URL=https://glpi.example.com
# Opzionale: se vuoto viene usato ${GLPI_BASE_URL}/apirest.php
GLPI_LEGACY_API_URL=

# Credenziali utente GLPI (per Basic Auth su initSession)
GLPI_API_USERNAME=CHANGE_ME
GLPI_API_PASSWORD=CHANGE_ME

# Application token del client API Legacy (Setup > Generale > API)
GLPI_LEGACY_APP_TOKEN=CHANGE_ME

# Itemtype del custom asset Nmap
GLPI_ITEMTYPE=Glpi\CustomAsset\NmapAsset

# Nomi esatti dei 3 campi custom dell'asset Nmap
FIELD_TCP_KEY=custom_tcp_ports
FIELD_UDP_KEY=custom_udp_ports
FIELD_SERVICES_KEY=custom_services

# File locale per ricordare IP -> GLPI ID
STATE_FILE=glpi_nmap_state_legacy.json

# Timeout richieste HTTP (secondi)
GLPI_HTTP_TIMEOUT=30
