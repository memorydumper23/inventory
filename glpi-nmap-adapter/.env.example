# Copy this file to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env

GLPI_BASE_URL=https://glpi.example.com
# Optional: if empty, ${GLPI_BASE_URL}/apirest.php is used
GLPI_LEGACY_API_URL=

# GLPI user credentials (Basic Auth on initSession)
GLPI_API_USERNAME=CHANGE_ME
GLPI_API_PASSWORD=CHANGE_ME

# Application token of the Legacy API client (Setup > General > API)
GLPI_LEGACY_APP_TOKEN=CHANGE_ME

# Itemtype of the Nmap custom asset
GLPI_ITEMTYPE=Glpi\CustomAsset\NmapAsset

# Exact API names of the 3 custom fields of the Nmap asset
FIELD_TCP_KEY=custom_tcp_ports
FIELD_UDP_KEY=custom_udp_ports
FIELD_SERVICES_KEY=custom_services

# Local file that maps IP -> GLPI ID
STATE_FILE=glpi_nmap_state_legacy.json

# HTTP request timeout (seconds)
GLPI_HTTP_TIMEOUT=30
