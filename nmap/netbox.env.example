# Copia questo file in netbox.env e inserisci i tuoi valori:
#   cp netbox.env.example netbox.env && chmod 600 netbox.env

export NETBOX_URL="https://netbox.example.com"
export NETBOX_TOKEN="CHANGE_ME"
export NETBOX_VERIFY_SSL="true"

# Internal name dei custom field NetBox sugli IP address
export NETBOX_CF_TCP_PORTS="porte_tcp"
export NETBOX_CF_UDP_PORTS="porte_udp"
export NETBOX_CF_SERVICES_DETAIL="servizi_dettaglio"

# Opzionale: hosts.yml Ansible da aggiornare con gli host trovati.
# Se vuoto, il passaggio viene saltato.
export ANSIBLE_INVENTORY_FILE=""

# Opzionale: disabilita il singolo push (default: true)
# export PUSH_TO_NETBOX="false"
# export PUSH_TO_GLPI="false"

# Opzionale: percorso dell'adapter GLPI (default: ../glpi-nmap-adapter)
# export GLPI_DIR="/opt/inventory/glpi-nmap-adapter"
