# Copy this file to netbox.env and fill in your values:
#   cp netbox.env.example netbox.env && chmod 600 netbox.env

export NETBOX_URL="https://netbox.example.com"
export NETBOX_TOKEN="CHANGE_ME"
export NETBOX_VERIFY_SSL="true"

# Internal names of the NetBox custom fields on IP addresses
export NETBOX_CF_TCP_PORTS="tcp_ports"
export NETBOX_CF_UDP_PORTS="udp_ports"
export NETBOX_CF_SERVICES_DETAIL="services_detail"

# Optional: Ansible hosts.yml to update with the hosts found.
# If empty, this step is skipped.
export ANSIBLE_INVENTORY_FILE=""

# Optional: disable a single push (default: true)
# export PUSH_TO_NETBOX="false"
# export PUSH_TO_GLPI="false"

# Optional: path of the GLPI adapter (default: ../glpi-nmap-adapter)
# export GLPI_DIR="/opt/inventory/glpi-nmap-adapter"
