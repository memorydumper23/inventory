# sudo rule for inventory: the user running the pipeline may run only the
# wrapper /usr/local/sbin/inventory-nmap as root, never nmap directly.
# Replace "inventory" with the user that runs the cron job.
#
# Installation:
#   sudo visudo -cf deploy/sudoers-inventory
#   sudo install -o root -g root -m 0440 deploy/sudoers-inventory /etc/sudoers.d/inventory

# cron has no terminal: on distributions with requiretty, sudo would fail
Defaults!/usr/local/sbin/inventory-nmap !requiretty

inventory ALL=(root) NOPASSWD: /usr/local/sbin/inventory-nmap
