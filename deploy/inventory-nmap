#!/bin/bash
# Wrapper run as root via sudo (see deploy/sudoers-inventory).
#
# Giving a user "sudo nmap" is the same as giving them root: --script runs Lua
# code, -iL reads any file, -oX writes anywhere. This wrapper exposes only the
# five scan profiles used by the pipeline, with fixed options:
#   - targets come in on stdin and the XML goes out on stdout, so nmap opens no
#     file at all (no reads or overwrites as root, no symlink attacks)
#   - the only accepted parameter is a list of numeric ports
#
# Installation (the file must be owned by root and not writable by others):
#   sudo install -o root -g root -m 0755 deploy/inventory-nmap /usr/local/sbin/inventory-nmap
set -euo pipefail

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
unset NMAPDIR

NMAP=/usr/bin/nmap
PORTSPEC_RE='^[0-9]{1,5}(,[0-9]{1,5})*$'

die() {
  echo "inventory-nmap: $*" >&2
  exit 2
}

no_args() {
  [[ $# -eq 0 ]] || die "this profile takes no arguments"
}

portspec() {
  [[ $# -eq 1 && $1 =~ $PORTSPEC_RE ]] || die "invalid port list (expected digits separated by commas only)"
  printf '%s' "$1"
}

MODE="${1:-}"
shift || true

case "$MODE" in
  discovery)
    no_args "$@"
    exec "$NMAP" -PR -sn -n -iL - -oX -
    ;;
  tcp-ports)
    no_args "$@"
    exec "$NMAP" -sS -Pn -n -p- --host-timeout 10m --min-hostgroup 4 --max-hostgroup 10 \
      --min-rate 5000 -iL - -oX -
    ;;
  tcp-services)
    PORTS="$(portspec "$@")"
    exec "$NMAP" -sV -Pn -n --version-light -p "$PORTS" -iL - -oX -
    ;;
  udp-ports)
    PORTS="$(portspec "$@")"
    exec "$NMAP" -sU -Pn -n -T4 --max-retries 2 -p "$PORTS" -iL - -oX -
    ;;
  udp-services)
    PORTS="$(portspec "$@")"
    exec "$NMAP" -sU -sV -Pn -n -T4 --version-light --max-retries 1 -p "$PORTS" -iL - -oX -
    ;;
  *)
    die "usage: inventory-nmap {discovery|tcp-ports|tcp-services|udp-ports|udp-services} [ports] < targets > output.xml"
    ;;
esac
